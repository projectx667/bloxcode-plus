{
  "name": "bloxcode-plus",
  "productName": "BloxCode Plus",
  "version": "2.0.0",
  "description": "Desktop visual editor for Roblox Luau, built with Blockly and Electron.",
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/projectx667/bloxcode-plus.git"
  },
  "keywords": [
    "roblox",
    "blockly",
    "luau",
    "visual-programming",
    "electron",
    "education"
  ],
  "author": "projectx667",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/projectx667/bloxcode-plus/issues"
  },
  "homepage": "https://github.com/projectx667/bloxcode-plus#readme",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "electron": "^44.0.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "public/favicon.ico"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "bloxcode_plus"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": ["darwin", "linux"]
        }
      ]
    }
  }
}
